# Configuration template. Copy to .env, chmod 600 .env, and fill in local settings.
# Managed units read .env; manual startup requires --env-file .env explicitly.
# A fresh installation needs local data storage; these paths are examples.
FIELD_HOST=127.0.0.1
FIELD_PORT=8188
# Leave the receiver unset for local photo upload and QR sample use.
# Receiver or snapshot URL requires the exact camera ID; never select a guessed device.
# Managed camera capture requires a Receiver URL; snapshot-only is single-process compatibility.
# FIELD_RECEIVER_URL=http://receiver-host:8080
# FIELD_CAMERA_ID=sender_cam01
# FIELD_DEMO_DATA=/absolute/path/to/FieldRecognition/Data
# FIELD_CAMERA_SNAPSHOT_URL=http://camera-host/snapshot.jpg

# OCR device: cpu (portable default), or gpu:0 after installing GPU dependencies.
# See docs/GPU部署.md. Apply changes only offline or in an authorized stop window.
# FIELD_OCR_DEVICE=gpu:0
# FLAGS_allocator_strategy=auto_growth

# Enable unattended scanning after a person registers an operator in the local UI.
# Registration and pause/resume settings are persisted per camera in the local DB.
# No operator is inferred from the OS account or previous test records.
# FIELD_AUTO_RUN_ENABLED=1

# Read only the configured camera's voice photos, even without a binding.
# Poll/stability intervals: 0.5 s each; prewarm OCR at service startup.
# Original source files are never changed; stage latency is retained per job.
# FIELD_SAVED_PHOTO_ROOT=/mnt/field-data/voice_photos
# During an upload-root migration, watch both explicit roots. Relative capture
# IDs remain unchanged; processed outputs (date_camera/VoicePhotoReadings) are excluded.
# FIELD_SAVED_PHOTO_ADDITIONAL_ROOTS=["/mnt/field-data/FieldRecognitionArchive"]
# Uploader owns YYYY-MM-DD_camera/MetaData/HH-MM-SS/*.jpg; recognition owns
# the sibling VoicePhotoReadings. Existing IDs and receipts stay unchanged.
# FIELD_ARCHIVE_LAYOUT=metadata
# FIELD_SAVED_PHOTO_TIMEZONE=Asia/Shanghai
# FIELD_SAVED_PHOTO_WATCH_ENABLED=1

# Run here; archive to a separate writable NAS folder. No program runs on NAS.
# Keep the SQLite database and retry queue on this computer, never on SMB.
# FIELD_ARCHIVE_ENABLED=1
# FIELD_ARCHIVE_ROOT=/mnt/field-data/FieldRecognitionArchive
# FIELD_ARCHIVE_MOUNT=/mnt/field-data
# Verify acknowledged receipt/image hashes daily on this computer (minimum 3600 s).
# First check starts with the archive service; reports survive restarts.
# FIELD_ARCHIVE_CHECK_SECONDS=86400

# Continuous local video OCR at up to 2 fresh frames/s. Saved photos take priority.
# UI pause/resume is persisted; ordinary frames remain in memory.
# FIELD_VIDEO_OCR_ENABLED=1
# 稳定且读数不变时定期保存新帧；不代表每个瞬间都被采样。
# FIELD_VIDEO_EVIDENCE_INTERVAL_SECONDS=30

# Optional Aliyun vision fallback; store the real key only in untracked .env.
# DASHSCOPE_API_KEY=your-local-key
# FIELD_ALIYUN_FALLBACK_ENABLED=1
# FIELD_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# FIELD_ALIYUN_MODEL=qwen3.8-max
# FIELD_ALIYUN_ENABLE_THINKING=1
# FIELD_ALIYUN_NO_DIGITS_SECONDS=5
# Existing automatic outputs are test material. Production photos require draft confirmation.
FIELD_RECORD_MODE=test
# auto: load sample registries only in test mode; production starts without them.
# none: skip import; sample: explicitly import bundled QR identities. Existing data stays.
FIELD_REGISTRY_POLICY=auto

# Managed deployment: install deployment/field-recognition.target after migrations.
# Units set FIELD_PRODUCTION_ENABLED=1 and their own FIELD_SERVICE_ROLE.
# Do not set FIELD_SERVICE_ROLE in this shared EnvironmentFile.
# Open the local workbench directly; login is independent of managed/record modes.
FIELD_AUTH_ENABLED=0
# Optional URL for the private initial login receipt (prepare_runtime.py only).
# FIELD_LOGIN_URL=https://workbench.example/login
# Login session and cookie lifetime, when login is enabled (1–72 hours).
FIELD_SESSION_DURATION_HOURS=8
# FIELD_DATABASE_PATH=/absolute/path/to/FieldRecognition/Data/Demo.sqlite3

# Optional: business worker delegates OCR to a separately scheduled GPU service.
# Provision a private client/scope and a read-only worker mount for this local spool.
# Set these in the OCR worker's private EnvironmentFile, never in browser code.
# FIELD_OCR_SERVICE_URL=http://127.0.0.1:8189
# FIELD_OCR_SERVICE_TOKEN_FILE=/private/StandaloneOcrToken
# FIELD_OCR_SERVICE_SCOPE=field-workbench-local
# FIELD_OCR_SERVICE_STORAGE=field-workbench-spool
# FIELD_OCR_SERVICE_MODEL_REVISION=<verified-64-character-model-digest>
# FIELD_OCR_SERVICE_SPOOL=/local/WorkbenchOcrSpool
# FIELD_OCR_SERVICE_CA=/private/TrustedCA.pem
# Optional panel detector defaults to CPU; GPU selection must be explicit.
# FIELD_PANEL_DEVICE=cpu
# CUDA_VISIBLE_DEVICES=
# Archive pauses under this free-space reserve, retaining the local outbox.
# FIELD_ARCHIVE_MIN_FREE_BYTES=268435456

# Bound each read/list operation against a slow or disconnected NAS (seconds).
FIELD_PHOTO_IO_TIMEOUT_SECONDS=4
# Set 1 only when the capture producer publishes PhotoReceipt.json for each measurement.
# Existing NAS JPG-only captures keep the default 0 (no inferred burst grouping).
FIELD_PHOTO_RECEIPT_REQUIRED=0
# 默认只依据显式连拍回执归组。确认“一目录=一次语音三连拍”来源约定后，
# 新部署可设 directory_triplet；不写源 NAS，不重组已导入历史照片。
# NAS 维护期间不要启用未经现场核对的目录约定。
FIELD_VOICE_PHOTO_BATCH_MODE=receipt_only
# Optional explicit local PP-OCRv5 model directories. Complete ~/.paddlex cache
# is selected automatically, so an unreachable model host does not block boot.
# FIELD_OCR_DET_MODEL_DIR=/absolute/path/to/PP-OCRv5_mobile_det
# FIELD_OCR_REC_MODEL_DIR=/absolute/path/to/PP-OCRv5_mobile_rec

# Explicit alternative vision provider; keep real credentials in an untracked store.
# FIELD_VISION_PROVIDER=nianfeng
# FIELD_VISION_ENABLED=1
# FIELD_VISION_API_KEY=your-local-key
# FIELD_VISION_BASE_URL=https://api.nianfeng.tech/v1
# FIELD_VISION_MODEL=claude-opus-5
# Primary photos use the model immediately; unbound results remain review candidates.
# FIELD_VISION_PHOTO_MODE=primary
# Speed-first Aliyun photos: reuse DASHSCOPE_API_KEY, set all four options below.
# FIELD_VISION_PROVIDER=aliyun
# FIELD_ALIYUN_FALLBACK_ENABLED=1
# FIELD_ALIYUN_MODEL=qwen3.8-flash
# FIELD_ALIYUN_ENABLE_THINKING=0
# Keep FIELD_VISION_PHOTO_MODE=primary for immediate photo vision calls.
# Only apply this template after the user confirms the visible device type and display rule.
# FIELD_VISION_DISPLAY_RULES=[{"instrument_type":"balance","measurement_name":"质量","unit":"g","decimal_places":4,"fixed_decimal_display":true,"confirmed_by_user":true}]
