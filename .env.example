# Optional systemd EnvironmentFile. Copy to .env and fill in local settings.
# Leave the receiver unset for local photo upload and QR sample use.
# FIELD_RECEIVER_URL=http://receiver-host:8080
# FIELD_CAMERA_ID=sender_cam01
# FIELD_DEMO_DATA=/absolute/path/to/FieldRecognitionDemo/Data
# FIELD_CAMERA_SNAPSHOT_URL=http://camera-host/snapshot.jpg

# Read only the bound camera's voice photographs. Nothing is written back to NAS.
# FIELD_SAVED_PHOTO_ROOT=/mnt/realityloop-nas/voice_photos
# FIELD_SAVED_PHOTO_TIMEZONE=Asia/Shanghai
# FIELD_SAVED_PHOTO_WATCH_ENABLED=1

# Optional Aliyun vision fallback; store the real key only in untracked .env.
# DASHSCOPE_API_KEY=your-local-key
# FIELD_ALIYUN_FALLBACK_ENABLED=1
# FIELD_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# FIELD_ALIYUN_MODEL=qwen3.8-max
# FIELD_ALIYUN_NO_DIGITS_SECONDS=5
