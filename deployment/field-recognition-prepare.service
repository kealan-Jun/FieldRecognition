# Template: render with scripts/install_runtime.py; do not copy directly.
[Unit]
Description=Validate and migrate FieldRecognition before writers start
PartOf=field-recognition.target
Before=field-recognition-api.service field-recognition-ocr.service field-recognition-cameras.service field-recognition-archive.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@PROJECT_ROOT@
EnvironmentFile=-@SERVICE_ENV_FILE@
EnvironmentFile=@ENV_FILE@
ExecStart=/usr/bin/env ./.venv/bin/python -m runtime_prepare
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=field-recognition.target
