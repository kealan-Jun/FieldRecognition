# Template: render with scripts/install_runtime.py; do not copy directly.
[Unit]
Description=FieldRecognition ocr
PartOf=field-recognition.target
Requires=field-recognition-prepare.service
After=network-online.target field-recognition-prepare.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=120
TimeoutStartSec=120
WorkingDirectory=@PROJECT_ROOT@
EnvironmentFile=-@SERVICE_ENV_FILE@
EnvironmentFile=@ENV_FILE@
Environment=FIELD_PRODUCTION_ENABLED=1
Environment=FIELD_SERVICE_ROLE=ocr
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
ExecStart=/usr/bin/env ./.venv/bin/python -m ocr_worker --persistent
Restart=always
RestartSec=5
TimeoutStopSec=25
KillMode=control-group
UMask=0077
NoNewPrivileges=true
LimitNOFILE=4096
MemoryMax=8G

[Install]
WantedBy=field-recognition.target
