{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:field-recognition:instrument-measurement:1",
  "title": "单台仪器测量记录",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wearer_id",
    "device_model",
    "device_no",
    "qr_hash",
    "photo_time",
    "values"
  ],
  "properties": {
    "wearer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "device_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "device_no": {
      "type": [
        "string",
        "null"
      ]
    },
    "qr_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "photo_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp_ms",
        "time"
      ],
      "properties": {
        "timestamp_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "time": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3}$"
        }
      },
      "oneOf": [
        {
          "properties": {
            "timestamp_ms": {
              "type": "null"
            },
            "time": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "timestamp_ms": {
              "type": "integer"
            },
            "time": {
              "type": "string"
            }
          }
        }
      ]
    },
    "values": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/value"
                },
                {
                  "properties": {
                    "name": {
                      "const": "温度"
                    },
                    "unit": {
                      "enum": [
                        "°C",
                        null
                      ]
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/value"
                },
                {
                  "properties": {
                    "name": {
                      "const": "转速"
                    },
                    "unit": {
                      "enum": [
                        "rpm",
                        null
                      ]
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/value"
                },
                {
                  "properties": {
                    "name": {
                      "const": "质量"
                    },
                    "unit": {
                      "enum": [
                        "g",
                        "mg",
                        "kg",
                        null
                      ]
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        }
      ]
    }
  },
  "$defs": {
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit",
        "range"
      ],
      "properties": {
        "name": {
          "enum": [
            "温度",
            "转速",
            "质量"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "display_state": {
          "const": "OFF",
          "description": "明确识别的屏幕状态；存在时 value 为 null，不表示数值零。"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "dependentSchemas": {
        "display_state": {
          "properties": {
            "value": {"type": "null"}
          }
        }
      }
    }
  }
}
